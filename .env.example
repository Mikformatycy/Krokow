# Local development only. These are public example credentials, not secrets.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_DB=krok_local
POSTGRES_USER=krok_local
POSTGRES_PASSWORD=krok_local_development_only

# API is local by default. Choose pilot for archived Krakow data or synthetic for fictional examples.
API_HOST=127.0.0.1
API_PORT=3001
API_DATA_MODE=unavailable
API_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8085

# Set in the Expo process before starting mobile; public URL, no secrets.
# On a phone use the computer's LAN address, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
